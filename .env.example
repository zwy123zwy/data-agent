# 环境变量配置示例

# 应用配置
APP_NAME=Python Agent V2
APP_VERSION=0.1.0
DEBUG=true

# 数据库配置
# MySQL 示例
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/dataagent

# SQLite 示例（开发环境）
# DATABASE_URL=sqlite+aiosqlite:///./dataagent.db

# LLM 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.0

# 服务配置
HOST=0.0.0.0
PORT=8200

# 日志配置
LOG_LEVEL=INFO

# HARNESS_GATEWAY_ALLOW_V1_FALLBACK=false

# [阶段1] Harness 系统提示词（相对 backend 根目录 prompts/harness/）
# HARNESS_PROMPTS_DIR=prompts/harness
# HARNESS_PROMPTS_HOT_RELOAD=false
